NODE_ENV=development
HOST=0.0.0.0
PORT=5006
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=500
APP_URL=http://localhost:5173
ACCESS_TOKEN_SECRET=generate-a-random-secret-with-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24
AUTH_COOKIE_NAME=interakt_refresh

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Interakt

DATABASE_URL=postgresql://postgres:replace-with-a-secure-password@localhost:5432/interakt?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-with-a-secure-password
DB_NAME=interakt
DB_SSL=false
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_SYSTEM_USER_ACCESS_TOKEN=
META_WEBHOOK_URL=
META_TOKEN_ENCRYPTION_KEY=
META_REVIEW_ADMIN_KEY=
META_GRAPH_API_VERSION=v25.0

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback

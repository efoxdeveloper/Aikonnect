generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum WhatsAppConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  ERROR
}

enum WhatsAppPhoneNumberStatus {
  PENDING
  ACTIVE
  DISCONNECTED
  ERROR
}

enum ContactTaskStatus {
  OPEN
  COMPLETED
}

enum ContactCustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
}

enum ContactConsentEventType {
  OPT_IN
  OPT_OUT
  BLOCK
  UNBLOCK
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum MessageDirection {
  INCOMING
  OUTGOING
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LOCATION
  CONTACT
  INTERACTIVE
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  DELETED
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum AutomationRunStatus {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum WorkflowRunStatus {
  WAITING
  COMPLETED
  FAILED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  PAUSED
}

enum CampaignKind {
  ONE_TIME
  ONGOING
  API
}

enum CampaignRecipientStatus {
  PENDING
  ATTEMPTED
  SENT
  DELIVERED
  READ
  REPLIED
  FAILED
}

model User {
  id                         String                   @id @default(uuid()) @db.Uuid
  email                      String                   @unique @db.VarChar(320)
  passwordHash               String                   @map("password_hash")
  firstName                  String                   @map("first_name") @db.VarChar(100)
  lastName                   String                   @map("last_name") @db.VarChar(100)
  phone                      String?                  @db.VarChar(30)
  status                     UserStatus               @default(ACTIVE)
  emailVerifiedAt            DateTime?                @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt                DateTime?                @map("last_login_at") @db.Timestamptz(3)
  createdAt                  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  ownedWorkspaces            Workspace[]              @relation("WorkspaceOwner")
  memberships                WorkspaceMember[]
  sessions                   Session[]
  oauthAccounts              OAuthAccount[]
  invitationsSent            WorkspaceInvitation[]    @relation("InvitationSender")
  emailVerificationTokens    EmailVerificationToken[]
  passwordResetTokens        PasswordResetToken[]
  contactsCreated            Contact[]                @relation("ContactCreator")
  contactsOwned              Contact[]                @relation("ContactAccountOwner")
  contactsUpdated            Contact[]                @relation("ContactUpdater")
  contactsDeleted            Contact[]                @relation("ContactDeleter")
  contactTasksCreated        ContactTask[]            @relation("ContactTaskCreator")
  contactTasksUpdated        ContactTask[]            @relation("ContactTaskUpdater")
  contactNotesCreated        ContactNote[]            @relation("ContactNoteCreator")
  contactNotesUpdated        ContactNote[]            @relation("ContactNoteUpdater")
  contactNotesDeleted        ContactNote[]            @relation("ContactNoteDeleter")
  contactSegmentsCreated     ContactSegment[]         @relation("ContactSegmentCreator")
  contactSegmentsUpdated     ContactSegment[]         @relation("ContactSegmentUpdater")
  contactCustomFieldsCreated ContactCustomField[]     @relation("ContactCustomFieldCreator")
  contactCustomFieldsUpdated ContactCustomField[]     @relation("ContactCustomFieldUpdater")
  contactConsentEvents       ContactConsentEvent[]    @relation("ContactConsentEventActor")
  messagesCreated            Message[]                @relation("MessageCreator")
  templatesCreated           Template[]               @relation("TemplateCreator")
  templatesUpdated           Template[]               @relation("TemplateUpdater")
  templatesDeleted           Template[]               @relation("TemplateDeleter")
  automationsCreated         Automation[]             @relation("AutomationCreator")
  workflowsCreated           Workflow[]               @relation("WorkflowCreator")
  campaignsCreated           Campaign[]               @relation("CampaignCreator")
  apiKeysCreated             PublicApiKey[]           @relation("ApiKeyCreator")
  webhookEndpointsCreated    WebhookEndpoint[]        @relation("WebhookEndpointCreator")

  @@index([status])
  @@map("users")
}

model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String   @db.VarChar(50)
  providerAccountId String   @map("provider_account_id") @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("oauth_accounts")
}

model Workspace {
  id                       String                    @id @default(uuid()) @db.Uuid
  name                     String                    @db.VarChar(160)
  slug                     String                    @unique @db.VarChar(180)
  companyName              String?                   @map("company_name") @db.VarChar(160)
  companyWebsite           String?                   @map("company_website") @db.VarChar(500)
  companyLocation          String?                   @map("company_location") @db.VarChar(200)
  annualRevenue            String?                   @map("annual_revenue") @db.VarChar(50)
  logoData                 String?                   @map("logo_data") @db.Text
  country                  String?                   @db.VarChar(100)
  timezone                 String?                   @db.VarChar(100)
  onboardingCompletedAt    DateTime?                 @map("onboarding_completed_at") @db.Timestamptz(3)
  ownerId                  String                    @map("owner_id") @db.Uuid
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner                    User                      @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships              WorkspaceMember[]
  roles                    Role[]
  invitations              WorkspaceInvitation[]
  setupProgress            WorkspaceSetupProgress?
  whatsappBusinessAccounts WhatsAppBusinessAccount[]
  contacts                 Contact[]
  contactTags              ContactTag[]
  contactTasks             ContactTask[]
  contactNotes             ContactNote[]
  contactSegments          ContactSegment[]
  contactCustomFields      ContactCustomField[]
  contactConsentEvents     ContactConsentEvent[]
  conversations            Conversation[]
  messages                 Message[]
  templates                Template[]
  automations              Automation[]
  automationLogs           AutomationLog[]
  workflows                Workflow[]
  workflowRuns             WorkflowRun[]
  campaigns                Campaign[]
  campaignRecipients       CampaignRecipient[]
  apiKeys                  PublicApiKey[]
  webhookEndpoints         WebhookEndpoint[]

  @@index([ownerId])
  @@map("workspaces")
}

model Template {
  id                  String         @id @default(uuid()) @db.Uuid
  workspaceId         String         @map("workspace_id") @db.Uuid
  metaTemplateId      String?        @map("meta_template_id") @db.VarChar(100)
  metaWabaId          String?        @map("meta_waba_id") @db.VarChar(100)
  metaTemplateName    String?        @map("meta_template_name") @db.VarChar(512)
  metaLanguageCode    String?        @map("meta_language_code") @db.VarChar(50)
  metaStatus          String?        @map("meta_status") @db.VarChar(50)
  metaRejectionReason String?        @map("meta_rejection_reason") @db.Text
  name                String         @db.VarChar(160)
  templateKey         String         @map("template_key") @db.VarChar(180)
  category            String         @db.VarChar(40)
  language            String         @db.VarChar(50)
  templateType        String         @map("template_type") @db.VarChar(40)
  headerType          String         @default("none") @map("header_type") @db.VarChar(20)
  headerText          String?        @map("header_text") @db.VarChar(60)
  headerFileName      String?        @map("header_file_name") @db.VarChar(255)
  body                String         @db.Text
  footer              String?        @db.VarChar(60)
  content             Json           @default("{}") @db.JsonB
  status              TemplateStatus @default(DRAFT)
  createdById         String?        @map("created_by_id") @db.Uuid
  updatedById         String?        @map("updated_by_id") @db.Uuid
  deletedById         String?        @map("deleted_by_id") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz(3)
  workspace           Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy           User?          @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           User?          @relation("TemplateUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy           User?          @relation("TemplateDeleter", fields: [deletedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, templateKey])
  @@unique([workspaceId, metaTemplateId])
  @@index([workspaceId, status, updatedAt, id])
  @@index([workspaceId, metaWabaId, status])
  @@index([workspaceId, deletedAt, updatedAt, id])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("templates")
}

model PublicApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  createdById String?   @map("created_by_id") @db.Uuid
  name        String    @db.VarChar(100)
  keyPrefix   String    @map("key_prefix") @db.VarChar(32)
  keyHash     String    @unique @map("key_hash") @db.VarChar(64)
  scopes      String[]  @default([])
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, revokedAt, createdAt])
  @@index([createdById])
  @@map("public_api_keys")
}

model WebhookEndpoint {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  createdById     String?   @map("created_by_id") @db.Uuid
  name            String    @db.VarChar(100)
  url             String    @db.VarChar(500)
  secretEncrypted String    @map("secret_encrypted") @db.Text
  events          String[]  @default([])
  active          Boolean   @default(true)
  lastDeliveredAt DateTime? @map("last_delivered_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User?     @relation("WebhookEndpointCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, active, createdAt])
  @@index([createdById])
  @@map("webhook_endpoints")
}

model Contact {
  id                   String                    @id @default(uuid()) @db.Uuid
  workspaceId          String                    @map("workspace_id") @db.Uuid
  name                 String                    @db.VarChar(160)
  phoneE164            String                    @map("phone_e164") @db.VarChar(20)
  whatsappId           String?                   @map("whatsapp_id") @db.VarChar(64)
  profileName          String?                   @map("profile_name") @db.VarChar(160)
  profileImageUrl      String?                   @map("profile_image_url") @db.Text
  email                String?                   @db.VarChar(320)
  source               String                    @default("Manual") @db.VarChar(50)
  status               String                    @default("New Lead") @db.VarChar(50)
  userId               String?                   @map("user_id") @db.VarChar(160)
  accountOwnerId       String?                   @map("account_owner_id") @db.Uuid
  dealValue            Decimal?                  @map("deal_value") @db.Decimal(14, 2)
  whatsappOpted        Boolean                   @default(true) @map("whatsapp_opted")
  whatsappOptInSource  String?                   @map("whatsapp_opt_in_source") @db.VarChar(100)
  whatsappOptedInAt    DateTime?                 @map("whatsapp_opted_in_at") @db.Timestamptz(3)
  whatsappOptOutSource String?                   @map("whatsapp_opt_out_source") @db.VarChar(100)
  whatsappOptedOutAt   DateTime?                 @map("whatsapp_opted_out_at") @db.Timestamptz(3)
  marketingBlocked     Boolean                   @default(false) @map("marketing_blocked")
  marketingBlockedAt   DateTime?                 @map("marketing_blocked_at") @db.Timestamptz(3)
  marketingBlockSource String?                   @map("marketing_block_source") @db.VarChar(100)
  marketingBlockReason String?                   @map("marketing_block_reason") @db.VarChar(500)
  customAttributes     Json                      @default("{}") @map("custom_attributes") @db.JsonB
  createdById          String?                   @map("created_by_id") @db.Uuid
  updatedById          String?                   @map("updated_by_id") @db.Uuid
  deletedById          String?                   @map("deleted_by_id") @db.Uuid
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime?                 @map("deleted_at") @db.Timestamptz(3)
  workspace            Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy            User?                     @relation("ContactCreator", fields: [createdById], references: [id], onDelete: SetNull)
  accountOwner         User?                     @relation("ContactAccountOwner", fields: [accountOwnerId], references: [id], onDelete: SetNull)
  updatedBy            User?                     @relation("ContactUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy            User?                     @relation("ContactDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  tagAssignments       ContactTagAssignment[]
  tasks                ContactTask[]
  notes                ContactNote[]
  customFieldValues    ContactCustomFieldValue[]
  consentEvents        ContactConsentEvent[]
  conversations        Conversation[]
  messages             Message[]
  automationLogs       AutomationLog[]
  workflowRuns         WorkflowRun[]
  campaignRecipients   CampaignRecipient[]

  @@index([workspaceId, deletedAt, createdAt, id])
  @@index([workspaceId, deletedAt, name, id])
  @@index([workspaceId, deletedAt, phoneE164, id])
  @@index([workspaceId, deletedAt, email, id])
  @@index([workspaceId, deletedAt, source, id])
  @@index([workspaceId, deletedAt, profileName, id])
  @@index([workspaceId, updatedAt, id])
  @@index([workspaceId, source, createdAt])
  @@index([workspaceId, status, createdAt, id])
  @@index([accountOwnerId])
  @@index([workspaceId, deletedAt, whatsappOpted, marketingBlocked, id])
  @@index([workspaceId, whatsappId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("contacts")
}

model ContactConsentEvent {
  id          String                  @id @default(uuid()) @db.Uuid
  workspaceId String                  @map("workspace_id") @db.Uuid
  contactId   String                  @map("contact_id") @db.Uuid
  type        ContactConsentEventType
  source      String                  @db.VarChar(100)
  reason      String?                 @db.VarChar(500)
  occurredAt  DateTime                @map("occurred_at") @db.Timestamptz(3)
  actorUserId String?                 @map("actor_user_id") @db.Uuid
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  actorUser   User?                   @relation("ContactConsentEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, contactId, occurredAt, id])
  @@index([actorUserId])
  @@map("contact_consent_events")
}

model Conversation {
  id                 String               @id @default(uuid()) @db.Uuid
  workspaceId        String               @map("workspace_id") @db.Uuid
  contactId          String               @map("contact_id") @db.Uuid
  phoneNumberId      String?              @map("phone_number_id") @db.Uuid
  channelKey         String               @default("whatsapp") @map("channel_key") @db.VarChar(50)
  status             ConversationStatus   @default(OPEN)
  unreadCount        Int                  @default(0) @map("unread_count")
  lastMessagePreview String?              @map("last_message_preview") @db.Text
  lastMessageAt      DateTime?            @map("last_message_at") @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact            Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  phoneNumber        WhatsAppPhoneNumber? @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)
  messages           Message[]
  workflowRuns       WorkflowRun[]

  @@unique([workspaceId, contactId, channelKey])
  @@index([workspaceId, status, lastMessageAt, id])
  @@index([workspaceId, channelKey, status, lastMessageAt(sort: Desc), id(sort: Desc)], map: "conversations_workspace_channel_status_recent_idx")
  @@index([workspaceId, lastMessageAt(sort: Desc), id(sort: Desc)], map: "conversations_workspace_recent_idx")
  @@index([workspaceId, contactId, updatedAt, id])
  @@index([phoneNumberId])
  @@map("conversations")
}

model Message {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @map("workspace_id") @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  contactId      String           @map("contact_id") @db.Uuid
  metaMessageId  String?          @map("meta_message_id") @db.VarChar(200)
  direction      MessageDirection
  type           MessageType
  status         MessageStatus    @default(SENT)
  text           String?          @db.Text
  mediaId        String?          @map("media_id") @db.VarChar(255)
  mediaUrl       String?          @map("media_url") @db.Text
  payload        Json             @default("{}") @db.JsonB
  sentAt         DateTime         @map("sent_at") @db.Timestamptz(3)
  deliveredAt    DateTime?        @map("delivered_at") @db.Timestamptz(3)
  readAt         DateTime?        @map("read_at") @db.Timestamptz(3)
  failedAt       DateTime?        @map("failed_at") @db.Timestamptz(3)
  failureReason  String?          @map("failure_reason") @db.Text
  createdById    String?          @map("created_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact        Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdBy      User?            @relation("MessageCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, metaMessageId])
  @@index([workspaceId, conversationId, sentAt, id])
  @@index([workspaceId, contactId, sentAt, id])
  @@index([createdById])
  @@map("messages")
}

model ContactCustomField {
  id              String                    @id @default(uuid()) @db.Uuid
  workspaceId     String                    @map("workspace_id") @db.Uuid
  key             String                    @db.VarChar(80)
  label           String                    @db.VarChar(120)
  normalizedLabel String                    @map("normalized_label") @db.VarChar(120)
  type            ContactCustomFieldType
  options         Json                      @default("[]") @db.JsonB
  required        Boolean                   @default(false)
  position        Int                       @default(0)
  archivedAt      DateTime?                 @map("archived_at") @db.Timestamptz(3)
  createdById     String?                   @map("created_by_id") @db.Uuid
  updatedById     String?                   @map("updated_by_id") @db.Uuid
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace       Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User?                     @relation("ContactCustomFieldCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?                     @relation("ContactCustomFieldUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  values          ContactCustomFieldValue[]

  @@unique([workspaceId, key])
  @@unique([workspaceId, normalizedLabel])
  @@index([workspaceId, archivedAt, position, id])
  @@index([createdById])
  @@index([updatedById])
  @@map("contact_custom_fields")
}

model ContactCustomFieldValue {
  id           String             @id @default(uuid()) @db.Uuid
  workspaceId  String             @map("workspace_id") @db.Uuid
  contactId    String             @map("contact_id") @db.Uuid
  fieldId      String             @map("field_id") @db.Uuid
  textValue    String?            @map("text_value") @db.Text
  numberValue  Float?             @map("number_value")
  dateValue    DateTime?          @map("date_value") @db.Date
  booleanValue Boolean?           @map("boolean_value")
  stringValues String[]           @default([]) @map("string_values")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  contact      Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  field        ContactCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([contactId, fieldId])
  @@index([workspaceId, fieldId, textValue, contactId])
  @@index([workspaceId, fieldId, numberValue, contactId])
  @@index([workspaceId, fieldId, dateValue, contactId])
  @@index([workspaceId, fieldId, booleanValue, contactId])
  @@index([stringValues], type: Gin)
  @@index([contactId])
  @@map("contact_custom_field_values")
}

model ContactSegment {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  name           String    @db.VarChar(120)
  normalizedName String    @map("normalized_name") @db.VarChar(120)
  definition     Json      @db.JsonB
  createdById    String?   @map("created_by_id") @db.Uuid
  updatedById    String?   @map("updated_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User?     @relation("ContactSegmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?     @relation("ContactSegmentUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, updatedAt])
  @@index([createdById])
  @@index([updatedById])
  @@map("contact_segments")
}

model ContactTask {
  id          String            @id @default(uuid()) @db.Uuid
  workspaceId String            @map("workspace_id") @db.Uuid
  contactId   String            @map("contact_id") @db.Uuid
  title       String            @db.VarChar(160)
  description String?           @db.Text
  dueAt       DateTime?         @map("due_at") @db.Timestamptz(3)
  status      ContactTaskStatus @default(OPEN)
  completedAt DateTime?         @map("completed_at") @db.Timestamptz(3)
  createdById String?           @map("created_by_id") @db.Uuid
  updatedById String?           @map("updated_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
